<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="laporan_hasil_ahp" pageWidth="595" pageHeight="842"
              columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <queryString>
        <![CDATA[
            SELECT k.kode_kriteria, k.nama_kriteria,
                   h.bobot_prioritas, h.lambda_maks,
                   h.consistency_index, h.consistency_ratio,
                   h.keterangan_cr, h.tanggal_hitung
            FROM hasil_ahp h
            JOIN kriteria k ON h.id_kriteria = k.id_kriteria
            ORDER BY h.bobot_prioritas DESC
        ]]>
    </queryString>

    <field name="kode_kriteria" class="java.lang.String"/>
    <field name="nama_kriteria" class="java.lang.String"/>
    <field name="bobot_prioritas" class="java.lang.Double"/>
    <field name="lambda_maks" class="java.lang.Double"/>
    <field name="consistency_index" class="java.lang.Double"/>
    <field name="consistency_ratio" class="java.lang.Double"/>
    <field name="keterangan_cr" class="java.lang.String"/>
    <field name="tanggal_hitung" class="java.sql.Date"/>

    <variable name="rowNumber" class="java.lang.Integer" resetType="Report" calculation="Count">
        <variableExpression><![CDATA[Boolean.TRUE]]></variableExpression>
    </variable>

    <title>
        <band height="60">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[LAPORAN HASIL PERHITUNGAN AHP]]></text>
            </staticText>
            <textField pattern="dd MMMMM yyyy">
                <reportElement x="0" y="30" width="555" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="12"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="30">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="35" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[No]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="35" y="0" width="65" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Kode]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="100" y="0" width="130" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Nama Kriteria]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="230" y="0" width="85" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Bobot]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="315" y="0" width="80" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Lambda]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="395" y="0" width="55" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[CI]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="450" y="0" width="55" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[CR]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="505" y="0" width="50" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Ket.]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="25">
            <textField>
                <reportElement x="0" y="0" width="35" height="25"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{rowNumber}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="35" y="0" width="65" height="25"/>
                <box leftPadding="5"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{kode_kriteria}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="100" y="0" width="130" height="25"/>
                <box leftPadding="5"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nama_kriteria}]]></textFieldExpression>
            </textField>
            <textField pattern="0.0000">
                <reportElement x="230" y="0" width="85" height="25"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{bobot_prioritas}]]></textFieldExpression>
            </textField>
            <textField pattern="0.0000">
                <reportElement x="315" y="0" width="80" height="25"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{lambda_maks}]]></textFieldExpression>
            </textField>
            <textField pattern="0.0000">
                <reportElement x="395" y="0" width="55" height="25"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{consistency_index}]]></textFieldExpression>
            </textField>
            <textField pattern="0.0000">
                <reportElement x="450" y="0" width="55" height="25"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{consistency_ratio}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="505" y="0" width="50" height="25"/>
                <box leftPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{keterangan_cr}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="230" y="5" width="100" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="Times New Roman" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Halaman " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>
