<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="laporan_teknisi" pageWidth="842" pageHeight="595"
              orientation="Landscape" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <queryString>
        <![CDATA[
            SELECT kode_teknisi, nama_teknisi, jenis_kelamin,
                   divisi, jabatan, no_telepon, email, status
            FROM teknisi
            ORDER BY kode_teknisi ASC
        ]]>
    </queryString>

    <field name="kode_teknisi" class="java.lang.String"/>
    <field name="nama_teknisi" class="java.lang.String"/>
    <field name="jenis_kelamin" class="java.lang.String"/>
    <field name="divisi" class="java.lang.String"/>
    <field name="jabatan" class="java.lang.String"/>
    <field name="no_telepon" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>

    <variable name="rowNumber" class="java.lang.Integer" resetType="Report" calculation="Count">
        <variableExpression><![CDATA[Boolean.TRUE]]></variableExpression>
    </variable>

    <title>
        <band height="60">
            <staticText>
                <reportElement x="0" y="0" width="802" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[LAPORAN DATA TEKNISI]]></text>
            </staticText>
            <textField pattern="dd MMMMM yyyy">
                <reportElement x="0" y="30" width="802" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="12"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="30">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="40" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[No]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="40" y="0" width="80" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Kode]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="120" y="0" width="140" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Nama Teknisi]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="260" y="0" width="80" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Gender]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="340" y="0" width="110" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Divisi]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="450" y="0" width="100" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Jabatan]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="550" y="0" width="100" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[No. Telepon]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="650" y="0" width="100" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="25">
            <textField>
                <reportElement x="0" y="0" width="40" height="25"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{rowNumber}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="40" y="0" width="80" height="25"/>
                <box leftPadding="5"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{kode_teknisi}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="120" y="0" width="140" height="25"/>
                <box leftPadding="5"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nama_teknisi}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="260" y="0" width="80" height="25"/>
                <box leftPadding="5"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{jenis_kelamin}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="340" y="0" width="110" height="25"/>
                <box leftPadding="5"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{divisi}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="450" y="0" width="100" height="25"/>
                <box leftPadding="5"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{jabatan}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="550" y="0" width="100" height="25"/>
                <box leftPadding="5"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{no_telepon}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="650" y="0" width="100" height="25"/>
                <box leftPadding="5"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="350" y="5" width="100" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="Times New Roman" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Halaman " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>
